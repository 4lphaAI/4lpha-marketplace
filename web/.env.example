# Marketplace UI env (copy to web/.env.local — NEVER copy the repo-root .env.local here).

# ── server-only (BFF; never reaches the browser) ─────────────────────────────
# Execution plane base URL + its shared perimeter token.
EXECUTION_URL=http://127.0.0.1:8090
EXECUTION_API_TOKEN=

# Data plane. The plane's own env var is DP_AUTH_TOKEN; this is our client copy,
# sent as the x-dp-token header.
DATA_PLANE_URL=https://data-plane-production.up.railway.app
DATA_PLANE_TOKEN=

# ── public (bundled into the browser) ────────────────────────────────────────
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# EIP-712 domain inputs — MUST match the execution server's network/chain/salt.
NEXT_PUBLIC_EXEC_CHAIN_ID=56
NEXT_PUBLIC_EXEC_NETWORK=mainnet
# Set ONLY if the server sets EXECUTION_ENV_SALT (same value, verbatim).
NEXT_PUBLIC_EXEC_ENV_SALT=

# ── passkey owner auth (R5) ──────────────────────────────────────────────────
# The RP ID the browser registers credentials under. MUST equal the execution
# plane's PASSKEY_RP_ID — WebAuthn scopes a credential by RP ID, so a mismatch
# produces assertions the plane refuses with a generic 401.
# Left unset, the UI falls back to location.hostname (correct on localhost).
NEXT_PUBLIC_PASSKEY_RP_ID=localhost
# Advertise the passkey affordance. The credential still works without it; this
# only gates UI copy.
NEXT_PUBLIC_PASSKEY_ENABLED=true

# LOCAL TEST (see "MD here/MARKETPLACE-ACCOUNT-PASSKEY-REVISION.md" §R5 local test):
# the execution plane must boot with
#   PASSKEY_ENABLED=true PASSKEY_RP_ID=localhost \
#   PASSKEY_ORIGINS=http://localhost:3000 PASSKEY_ALLOW_INSECURE_ORIGINS=true
# and the browser MUST be at exactly http://localhost:3000 — 127.0.0.1 is a
# different origin AND a different RP ID, and both checks refuse it.
