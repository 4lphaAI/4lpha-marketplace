# 4lpha execution plane — environment template.
#
# Copy to `.env` for local work. `.env` is gitignored and must never be
# committed. The spike writes generated test keys here automatically; nothing
# in this repo prints a key value.
#
# Layering, in precedence order:
#   1. a real environment variable
#   2. `.env.local`   operator-managed secrets. NEVER written by this repo.
#   3. `.env`         generated test keys. Written by the spike.
#
# A write to `.env` that a higher layer shadows is treated as an error, not as
# a success — see scripts/spike/env.ts.

# ---------------------------------------------------------------------------
# Spike keys
# ---------------------------------------------------------------------------

# Owner key. Simulates the end user. `npm run spike` generates one on first run
# if this is unset, then reuses it so the spike is resumable after funding.
# Testnet only: on mainnet the owner key must be operator-supplied.
# OWNER_TEST_KEY=0x...

# Agent session key. Supplied to grantSession so the granted session can be
# rebuilt byte-exact after a restart. Generated on first run if unset.
# AGENT_SESSION_TEST_KEY=0x...

# Mainnet session key. Generated on first mainnet run if unset.
# AGENT_SESSION_MAIN_KEY=0x...

# Which variable supplies the OWNER key. Defaults to OWNER_TEST_KEY on testnet
# and USER1_PRIVATE_KEY on mainnet. Point it at a different name to run the
# spike for a second owner — note the state file is bound to one owner and a
# mismatch aborts the run rather than resuming someone else's verdicts.
# SPIKE_OWNER_KEY_VAR=USER1_PRIVATE_KEY

# Permission to overwrite ONE existing key value, named explicitly. Without it,
# writing over a key that already has a value is refused: whatever the old
# address holds would become unreachable.
# SPIKE_ROTATE_KEY=AGENT_SESSION_TEST_KEY

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------

# `mainnet` runs the spike on BNB Chain 56 with REAL funds. Anything else (or
# unset) means BNB testnet, chain 97.
# SPIKE_NETWORK=testnet

# Required, verbatim, when SPIKE_NETWORK=mainnet. The spike sends value, pays a
# KeyStore registration fee, and sweeps a wallet; none of it is reversible.
# SPIKE_CONFIRM_MAINNET=i-understand-real-funds

# Override the public RPC used for reads and for the owner-only recovery path.
# Tried FIRST, ahead of the built-in endpoints, which remain as fallbacks. The
# provider verifies the endpoint's chain id before signing anything. Point this
# at a private endpoint in production; a public RPC is a liveness dependency,
# not a trust one.
# SPIKE_RPC_URL=https://bsc-testnet-rpc.publicnode.com

# ---------------------------------------------------------------------------
# Storage substrate (Phase 1a)
# ---------------------------------------------------------------------------

# Durable Postgres for the agent store and execution journal. When set, the
# stores use Postgres; when unset, they fall back to in-memory (state is lost on
# restart — dev only). The URL is never logged. Install `pg` for this path.
# DATABASE_URL=postgres://user:pass@host:5432/execution

# Master key for envelope-encrypting agent session keys at rest (AES-256-GCM).
# 32 bytes, given as 64 hex chars (optional 0x prefix) or base64.
#
# REQUIRED for Postgres: PostgresAgentStore REFUSES to persist a session key
# without it. The in-memory store tolerates its absence for local dev, holding
# keys in-process in plaintext. Never commit a real value; never log it.
# EXECUTION_MASTER_KEY=

# ---------------------------------------------------------------------------
# Owner authorization (Phase 1b)
# ---------------------------------------------------------------------------

# Per-environment EIP-712 domain salt for owner-action signatures. When set, it
# is the strongest separation between environments: a signature made in one
# environment cannot verify in another even at the same chain id (e.g. a mainnet
# fork reporting chainId 56). When UNSET, the salt is derived from
# `network:chainId`, so testnet (97) and mainnet (56) still differ. Set a
# distinct value per deployed environment (staging vs production).
# EXECUTION_ENV_SALT=

# ---------------------------------------------------------------------------
# HTTP service (Phase 1b-api)
# ---------------------------------------------------------------------------

# PRIVATE NETWORK ONLY. This service holds fund-moving keys and ships no CORS
# handling by design. The intended path is: owner browser -> the 4alpha app ->
# this execution plane. Never expose it to the internet.

# Which BNB network the service runs against. `mainnet` means chain 56 and REAL
# funds; anything else (or unset) means testnet, chain 97. The value is also
# folded into the EIP-712 domain salt when EXECUTION_ENV_SALT is unset.
# EXECUTION_NETWORK=testnet

# Port the HTTP service binds. Defaults to 8090.
# PORT=8090

# LAYER 1 — the SERVICE credential, sent as `x-exec-token` on every route except
# /health. It authenticates a calling service (our agent runtime, our app
# backend), NOT a tenant: holding it says nothing about whose agents you may
# touch. REQUIRED — the service refuses to start without it, because a blank
# value would mean running with the front door open.
# EXECUTION_API_TOKEN=

# Optional 32-byte HMAC key (exactly 64 lowercase hex characters) used by the
# app backend to exchange one nonce-consumed owner signature for a 15-minute,
# read-only Account portfolio bearer. Omit it to disable session exchange; the
# portfolio endpoint still accepts a request-bound signed owner read.
# OWNER_READ_SESSION_SECRET=

# REQUEST-BOUND RUNTIME AUTHORIZATION (Phase 1.6). The three autonomous HTTP
# routes (`GET /agents/:id`, `/trade`, and enabled raw `/execute`) require BOTH
# x-exec-token and a short-lived Ed25519 `x-runtime-assertion`. Configure issuer
# and public-key map together; omit both to keep those routes fail-closed at 503.
# Enabling requires an explicit EXECUTION_ENV_SALT above. Values in the JSON map
# are raw 32-byte Ed25519 public keys encoded as unpadded base64url (max 8).
# RUNTIME_ASSERTION_ISSUER=4lpha-runtime
# RUNTIME_ASSERTION_PUBLIC_KEYS_JSON={"runtime-2026-08":"<raw-public-key-base64url>"}

# CLIENT/ISSUER PROCESS ONLY. `src/index-server.ts` REFUSES TO BOOT if the
# private key is present. `live-trade` reads these to mint one request-bound
# assertion at a time; production issuer keys must live outside the public app
# tier and execution server.
# RUNTIME_ASSERTION_KEY_ID=runtime-2026-08
# RUNTIME_ASSERTION_PRIVATE_KEY=<ed25519-pkcs8-der-base64url>

# LAYER 3 — the OPERATOR credential, sent as `x-operator-token`, required in
# ADDITION to the service credential on /admin/halt and /admin/resume only.
# Those are cross-tenant by definition and no single owner may halt everyone, so
# they take their own credential in their own variable. REQUIRED. Every use is
# audit-logged with the caller-supplied actor and reason; the token itself is
# never logged.
# EXECUTION_OPERATOR_TOKEN=

# The data plane is the execution plane's ONLY outbound HTTP dependency: it must
# never contact a market-data provider directly. REQUIRED.
# DATA_PLANE_URL=http://data-plane.internal:8080

# Credential the data plane expects as `x-dp-token`. Optional; omitted rather
# than sent empty when unset, so a misconfiguration surfaces as a 401.
# DATA_PLANE_TOKEN=

# ---------------------------------------------------------------------------
# Trade ops (Phase 2)
# ---------------------------------------------------------------------------
#
# Every variable below is validated AT BOOT. A malformed value aborts the
# process; none of them can fail for the first time during a trade.

# Whether `POST /agents/:id/execute` — the RAW calldata route — is exposed.
# DEFAULT FALSE, and only the exact string `true` enables it; the route returns
# an ordinary 404 otherwise.
#
# Read this before setting it. The canonical trade session template grants
# `approve(address,uint256)` with no target constraint, because the tokens an
# agent will trade are not known at grant time. APPROVALS ARE NOT BOUNDED BY
# SPEND CAPS — approve moves nothing, it authorizes a later transferFrom this
# server never sees. The trade route is safe under that grant because it
# hardcodes the spender. The raw route is not: it accepts arbitrary calldata, so
# a leaked EXECUTION_API_TOKEN could approve every ERC-20 in the owner's EOA to
# an address of its choosing and drain them. Leave this off unless you are
# running reconcile tooling that needs it, and never with a funded wallet.
# EXECUTE_RAW_ENABLED=false

# Fee treasury and rate. BOTH or NEITHER — half a fee configuration aborts the
# boot. `FEE_BPS` is basis points, validated 1..500 (5% ceiling), so a typo
# meaning "10%" written as 1000 is refused rather than charged.
#
# The fee is ON TOP of the trade: `feeWei = amountWei * bps / 10_000`, the swap
# still sends `amountWei`, and the caps see `amountWei + feeWei`. Callers must
# size their trades for it — an amount exactly at `perTradeNativeWei` refuses.
#
# The treasury MUST be granted by the trade session template, or every trade is
# rejected on-chain; boot checks this and refuses to start otherwise. The
# ROADMAP treasury is 0x7e41F09dF5cb1Ec9323bC101D3a9e65bE4e510AD — a SINGLE KEY,
# to be replaced with a multisig before real volume.
# FEE_TREASURY_ADDRESS=
# FEE_BPS=

# Scan gate. `SCAN_MODE` is off | report | block, DEFAULT report.
#
# `report` reads the data plane's verdict and attaches any of the three fatal
# flags (honeypot, cannot_sell, blacklist) to the trade receipt as
# `meta.scanFlags` — and never refuses. `block` turns those flags into a
# refusal. `off` skips the read entirely.
#
# The default is `report` because of a measured case, not a preference: a
# Binance-listed token with 58 BNB of real liquidity was refused when ONE of
# the data plane's two scanners reported `honeypot` and the other reported a
# clean `ok`. The merge is conservative, so a single noisy scanner blocks a
# legitimate trade. The marketplace already picks tokens from a curated
# universe, and an attacker steering a leaked service credential at a honeypot
# is bounded by the on-chain spend caps either way — so blocking on that signal
# costs more real trades than it prevents bad ones. Set `block` if your
# deployment would rather refuse than trade on a flagged token.
# SCAN_MODE=report
#
# `SCAN_REQUIRE_VERDICT=true` additionally treats "no verdict obtainable" — the
# data plane is down, or no scanner has an opinion — as a finding. It only
# REFUSES when SCAN_MODE=block too; under `report` it just travels. Default
# false: an absent opinion is not evidence of a defect, and the default keeps a
# scanner outage from stopping trades the marketplace already decided on. Turn
# it on for a deployment that would rather halt than trade unscanned.
#
# `SCAN_TTL_SEC` is how long a real verdict is cached per (chain, token);
# default 300, capped at 900. A no-verdict answer is NEVER cached, so an outage
# cannot poison a token for the whole TTL.
# SCAN_REQUIRE_VERDICT=false
# SCAN_TTL_SEC=300

# Phase 3.24 atomic manual-exit conversion compatibility. Default/blank/[] is
# EMPTY: no base token enters the seven-call path unless the operator lists its
# exact address here. Malformed JSON, zero addresses and duplicates fail boot.
# LP_CONVERSION_COMPATIBLE_TOKENS_JSON=[]

# Phase 3.9c finalized landing evidence. OFF by default. Enabling is accepted
# only on chain 56 and only with at least two independent entries from the
# source-controlled registry. Requests cannot supply or override an endpoint;
# the observer performs read-only finalized full-block JSON-RPC in the
# background, while the owner resolver reads the durable local ledger only.
# LP_LANDING_EVIDENCE_ENABLED=false
# LP_LANDING_EVIDENCE_SOURCES_JSON=[]
# LP_EVIDENCE_EXPIRY_SAFETY_SECONDS=300
# LP_EVIDENCE_REQUEST_TIMEOUT_MS=6000
# LP_EVIDENCE_PER_SOURCE_CONCURRENCY=1
# LP_EVIDENCE_GLOBAL_CONCURRENCY=2
# LP_EVIDENCE_REQUESTS_PER_SECOND=2
# LP_EVIDENCE_CHUNK_BLOCKS=50
# LP_EVIDENCE_MAX_COLD_BACKFILL_BLOCKS=100000
# LP_EVIDENCE_MAX_BACKFILL_BLOCKS_PER_HOUR=20000
# LP_EVIDENCE_REORG_REWIND_BLOCKS=256
# LP_EVIDENCE_OWNER_SNAPSHOT_TIMEOUT_MS=250
# LP_EVIDENCE_MAX_GLOBAL_LOGICAL_BYTES=4294967296
# LP_EVIDENCE_MAX_VERSION_LOGICAL_BYTES=2147483648
# LP_EVIDENCE_MAX_VERSION_BLOCK_ROWS=2000000
# LP_EVIDENCE_MAX_VERSION_CANDIDATE_ROWS=500000
# LP_EVIDENCE_MAX_REQUIREMENTS=10000
# LP_EVIDENCE_MAX_ZERO_EXPIRY_REQUIREMENTS=1000
# LP_EVIDENCE_AUDIT_RETENTION_DAYS=180

# Slippage discipline. A trade must declare `minOutWei` and `quotedOutWei`, and
# is refused when `minOutWei` sits more than MAX_SLIPPAGE_BPS below the caller's
# own quote. Default 500 (5%), validated 1..2000 — past 20% the rule stops
# meaning anything. This service makes NO judgement about whether the quote
# itself is right; the caller's stated expectation is what binds it.
# MAX_SLIPPAGE_BPS=500

# How long a built swap stays valid, in seconds. Default 120. Every second is a
# window in which a held batch can be picked up at a worse price, so this is
# short on purpose. Max 900.
# TRADE_DEADLINE_SEC=120

# Venue address overrides, so a wrong or upgraded deployment is a config change
# rather than a release. Each is checksum-validated, refused if zero, and
# refused if it equals the KeyStore. Chains with no known deployment (including
# BNB testnet 97, where the circulating Pancake router is unverified and
# Four.Meme has no deployment) get NOTHING by default, and an unconfigured venue
# is a 400 — never a call to the zero address.
#
# Defaults on chain 56, verified against deployed bytecode:
#   VENUE_PANCAKE_ROUTER     0x10ED43C718714eb63d5aA57B78B54704E256024E
#   VENUE_PANCAKE_ROUTER_V3  0x1b81D678ffb9C0263b24A97847620C99d213eB14
#   VENUE_WBNB               0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c
#   VENUE_FOURMEME_HELPER    0xF251F83e40a78868FcfA3FA4599Dad6494E46034
#
# VENUE_PANCAKE_ROUTER_V3 is the DEDICATED V3 SwapRouter, deliberately NOT the
# SmartRouter 0x13f4EA83…. A `{ to: <router> }` allowlist rule grants every
# function the target exposes, and the SmartRouter additionally exposes V2 swaps,
# stable-swap entry points, wrapETH, approveMax and pull. Routing across venue
# types is also a market judgement this service does not make. The pancake_v3
# venue needs this AND VENUE_WBNB: every V3 path begins or ends at WBNB.
#
# VENUE_FOURMEME_HELPER is Four.Meme's `TokenManagerHelper3`, and its presence
# is what makes the fourmeme venue AVAILABLE on a chain: with no helper there is
# nothing to read, so the venue is a 400. Point it at the PROXY, not at the
# implementation behind it — the implementation moves under an upgrade.
#
# There is deliberately no VENUE_FOURMEME_MANAGER. The manager a trade calls is
# read on-chain per attempt, because V1 and V2 tokens live behind different
# managers; an override would look like a way to choose it, and is not one.
# VENUE_PANCAKE_ROUTER=
# VENUE_PANCAKE_ROUTER_V3=
# VENUE_WBNB=
# VENUE_FOURMEME_HELPER=

# Ceiling on how far a VENUE's own fee may push a Four.Meme buy's msg.value
# above the amountWei the caller declared, in basis points. Default 300 (3%)
# against a live venue fee of 100 bps; validated 1..1000.
#
# This is the bound on an untrusted number. The exact msg.value comes from an
# on-chain read, and verifying the RPC endpoint's chain id says nothing about
# any individual eth_call result — so a quote asking for meaningfully more
# native than the caller offered is refused before submit rather than left to an
# optional per-agent cap. Zero funds, zero msg.value or a zero estimate refuse
# too: the helper answers a non-token with all zeros and does not revert.
# MAX_VENUE_FEE_BPS=300

# Phase 5 paid-service gateway. All gates default OFF. `report` may validate
# checked-in fixtures/config only; it must not resolve paid hosts or load keys.
# Production `on` composes transport/store/gateway/worker/reconcilers in core
# and imports only the closed custody/credential/meter/relay primitive census
# from one locally reviewed, SHA-256-pinned adapter artifact.
# BILLING_ENABLED=off
# BILLING_X402_ENABLED=off
# BILLING_0G_ENABLED=off
# BILLING_INTERNAL_HOST=127.0.0.1
# BILLING_INTERNAL_PORT=8091
# BILLING_INFRASTRUCTURE_MODULE=file:///absolute/path/to/reviewed-billing-infrastructure.mjs
# BILLING_INFRASTRUCTURE_MODULE_SHA256=
# BILLING_COLLECTOR_ADDRESS=
# BILLING_COLLECTOR_RUNTIME_CODEHASH=
# BILLING_TREASURY_ADDRESS=
# BILLING_TICKET_KEY_ID=
# BILLING_TICKET_PUBLIC_KEY=
# BILLING_BSC_RPC_A=
# BILLING_BSC_RPC_B=
# BILLING_BASE_RPC_A=
# BILLING_BASE_RPC_B=
# BILLING_ARBITRUM_RPC_A=
# BILLING_ARBITRUM_RPC_B=
# BILLING_PLATFORM_BASE_USDC_CAP_ATOMIC=
# BILLING_PLATFORM_0G_CAP_NEURON=
# BILLING_X402_PAYER_KEY_ID=
# BILLING_X402_AUTHORIZER=
# BILLING_0G_PAYER_ACCOUNT_ID=
# BILLING_0G_INFERENCE_KEY_ID=
# BILLING_0G_MANAGEMENT_KEY_ID=
